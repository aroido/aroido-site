#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

swift - <<'SWIFT'
import AppKit
import Foundation

func load(_ path: String) -> NSImage {
    guard let image = NSImage(contentsOfFile: path) else {
        fputs("Missing image: \(path)\n", stderr)
        exit(1)
    }
    return image
}

func color(_ hex: UInt32, _ alpha: CGFloat = 1) -> NSColor {
    NSColor(
        calibratedRed: CGFloat((hex >> 16) & 255) / 255,
        green: CGFloat((hex >> 8) & 255) / 255,
        blue: CGFloat(hex & 255) / 255,
        alpha: alpha
    )
}

struct Sources {
    let icon = load("assets/tokenmon/tokenmon-icon-1024.png")
    let menu = load("assets/tokenmon/menu-overview-en-dark.png")
    let dex = load("assets/tokenmon/seen-dex-en-dark.png")
}

final class Renderer {
    let width: CGFloat
    let height: CGFloat
    let rep: NSBitmapImageRep

    init(width: CGFloat, height: CGFloat) {
        self.width = width
        self.height = height
        guard let bitmap = NSBitmapImageRep(
            bitmapDataPlanes: nil,
            pixelsWide: Int(width),
            pixelsHigh: Int(height),
            bitsPerSample: 8,
            samplesPerPixel: 4,
            hasAlpha: true,
            isPlanar: false,
            colorSpaceName: .deviceRGB,
            bytesPerRow: 0,
            bitsPerPixel: 0
        ) else {
            fputs("Could not create bitmap\n", stderr)
            exit(1)
        }
        bitmap.size = NSSize(width: width, height: height)
        self.rep = bitmap
        guard let context = NSGraphicsContext(bitmapImageRep: bitmap) else {
            fputs("Could not create graphics context\n", stderr)
            exit(1)
        }
        NSGraphicsContext.current = context
        context.imageInterpolation = .high
        context.shouldAntialias = true
    }

    func rect(_ x: CGFloat, _ y: CGFloat, _ w: CGFloat, _ h: CGFloat) -> CGRect {
        CGRect(x: x, y: height - y - h, width: w, height: h)
    }

    func fill(_ nsColor: NSColor, _ x: CGFloat, _ y: CGFloat, _ w: CGFloat, _ h: CGFloat) {
        nsColor.setFill()
        rect(x, y, w, h).fill()
    }

    func rounded(_ x: CGFloat, _ y: CGFloat, _ w: CGFloat, _ h: CGFloat, radius: CGFloat, fill: NSColor, stroke: NSColor? = nil, lineWidth: CGFloat = 1) {
        let path = NSBezierPath(roundedRect: rect(x, y, w, h), xRadius: radius, yRadius: radius)
        fill.setFill()
        path.fill()
        if let stroke {
            stroke.setStroke()
            path.lineWidth = lineWidth
            path.stroke()
        }
    }

    func backdrop() {
        fill(color(0x07100d), 0, 0, width, height)
        NSGradient(colors: [
            color(0x07100d),
            color(0x12281c),
            color(0x241827),
            color(0x0d1720)
        ])?.draw(in: rect(0, 0, width, height), angle: -18)
        fill(NSColor.black.withAlphaComponent(0.23), 0, 0, width, height)
    }

    func text(_ string: String, _ x: CGFloat, _ y: CGFloat, _ w: CGFloat, _ h: CGFloat, _ size: CGFloat, _ weight: NSFont.Weight, _ nsColor: NSColor, line: CGFloat? = nil, alignment: NSTextAlignment = .left) {
        let paragraph = NSMutableParagraphStyle()
        paragraph.alignment = alignment
        paragraph.lineBreakMode = .byWordWrapping
        if let line {
            paragraph.minimumLineHeight = line
            paragraph.maximumLineHeight = line
        }
        NSString(string: string).draw(
            with: rect(x, y, w, h),
            options: [.usesLineFragmentOrigin, .usesFontLeading],
            attributes: [
                .font: NSFont.systemFont(ofSize: size, weight: weight),
                .foregroundColor: nsColor,
                .paragraphStyle: paragraph,
                .kern: 0
            ]
        )
    }

    func image(_ image: NSImage, _ x: CGFloat, _ y: CGFloat, _ w: CGFloat, _ h: CGFloat, radius: CGFloat = 0) {
        let target = rect(x, y, w, h)
        if radius > 0 {
            let path = NSBezierPath(roundedRect: target, xRadius: radius, yRadius: radius)
            NSGraphicsContext.saveGraphicsState()
            path.addClip()
            image.draw(in: target, from: CGRect(origin: .zero, size: image.size), operation: .copy, fraction: 1, respectFlipped: false, hints: nil)
            NSGraphicsContext.restoreGraphicsState()
            color(0xffffff, 0.16).setStroke()
            path.lineWidth = 1
            path.stroke()
        } else {
            image.draw(in: target, from: CGRect(origin: .zero, size: image.size), operation: .copy, fraction: 1, respectFlipped: false, hints: nil)
        }
    }

    @discardableResult
    func screenshot(_ image: NSImage, _ x: CGFloat, _ y: CGFloat, _ w: CGFloat, radius: CGFloat = 26) -> CGFloat {
        let h = w / (image.size.width / max(image.size.height, 1))
        let target = rect(x, y, w, h)
        let path = NSBezierPath(roundedRect: target, xRadius: radius, yRadius: radius)
        let shadow = NSShadow()
        shadow.shadowColor = NSColor.black.withAlphaComponent(0.48)
        shadow.shadowOffset = NSSize(width: 0, height: -20)
        shadow.shadowBlurRadius = 34

        NSGraphicsContext.saveGraphicsState()
        shadow.set()
        color(0x091017, 0.96).setFill()
        path.fill()
        NSGraphicsContext.restoreGraphicsState()

        NSGraphicsContext.saveGraphicsState()
        path.addClip()
        image.draw(in: target, from: CGRect(origin: .zero, size: image.size), operation: .copy, fraction: 1, respectFlipped: false, hints: nil)
        NSGraphicsContext.restoreGraphicsState()

        color(0xffffff, 0.18).setStroke()
        path.lineWidth = 1
        path.stroke()
        return h
    }

    func brand(_ icon: NSImage, _ x: CGFloat, _ y: CGFloat, scale: CGFloat = 1) {
        let w = 280 * scale
        let h = 68 * scale
        rounded(x, y, w, h, radius: h / 2, fill: color(0x0b141d, 0.84), stroke: color(0xb9e39d, 0.26))
        image(icon, x + 18 * scale, y + 12 * scale, 44 * scale, 44 * scale, radius: 11 * scale)
        text("Tokenmon", x + 78 * scale, y + 17 * scale, 178 * scale, 32 * scale, 30 * scale, .heavy, color(0xf4fbff), line: 35 * scale)
    }

    func pill(_ label: String, _ x: CGFloat, _ y: CGFloat, _ w: CGFloat, tint: NSColor) {
        rounded(x, y, w, 52, radius: 26, fill: color(0x101923, 0.82), stroke: tint.withAlphaComponent(0.36))
        text(label, x + 24, y + 12, w - 48, 26, 23, .semibold, color(0xf4fbff), line: 28, alignment: .center)
    }

    func savePNG(_ path: String) {
        guard let data = rep.representation(using: .png, properties: [:]) else {
            fputs("Could not encode PNG: \(path)\n", stderr)
            exit(1)
        }
        do {
            try data.write(to: URL(fileURLWithPath: path))
        } catch {
            fputs("Could not write \(path): \(error)\n", stderr)
            exit(1)
        }
        NSGraphicsContext.current = nil
    }
}

let sources = Sources()

do {
    let r = Renderer(width: 2400, height: 1350)
    r.backdrop()
    r.brand(sources.icon, 96, 76)
    r.text("Keep coding.\nTokenmon collects quietly.", 96, 176, 1060, 190, 74, .heavy, color(0xffffff), line: 84)
    r.text("Claude Code and Codex usage becomes passive encounters, automatic results, and local Dex progress in your Mac menu bar.", 100, 408, 930, 100, 31, .semibold, color(0xdbe8f2), line: 41)
    r.rounded(100, 572, 830, 128, radius: 28, fill: color(0x071017, 0.86), stroke: color(0xffffff, 0.14))
    r.text("Usage -> Encounter -> Auto result -> Dex", 136, 614, 760, 34, 26, .heavy, color(0xf7fbff), line: 36)
    r.pill("No account", 100, 766, 188, tint: color(0xffd36b))
    r.pill("Local-first", 306, 766, 190, tint: color(0x8fe49d))
    r.pill("No prompt storage", 514, 766, 270, tint: color(0x88b7ff))
    r.text("Download DMG or install with Homebrew", 104, 876, 720, 32, 24, .semibold, color(0xc5d5e2), line: 32)
    r.screenshot(sources.menu, 1190, 120, 560)
    r.screenshot(sources.dex, 1386, 464, 760)
    r.savePNG("assets/tokenmon/tokenmon-site-hero.png")
}

do {
    let r = Renderer(width: 1200, height: 630)
    r.backdrop()
    r.brand(sources.icon, 50, 38, scale: 0.58)
    r.text("AI coding usage\nbecomes menu bar\nencounters.", 52, 116, 560, 164, 52, .heavy, color(0xffffff), line: 58)
    r.text("No account. Local-first. Dex grows automatically.", 54, 314, 470, 56, 22, .semibold, color(0xdbe8f2), line: 29)
    r.rounded(54, 420, 438, 62, radius: 22, fill: color(0x071017, 0.88), stroke: color(0xffd36b, 0.44), lineWidth: 1.4)
    r.text("Download DMG  +  Homebrew", 82, 438, 382, 28, 22, .heavy, color(0xffffff), line: 28)
    r.screenshot(sources.menu, 646, 42, 330, radius: 20)
    r.screenshot(sources.dex, 552, 284, 494, radius: 18)
    r.savePNG("assets/og/tokenmon-og.png")
}

print("tokenmon_site_hero=assets/tokenmon/tokenmon-site-hero.png")
print("tokenmon_og=assets/og/tokenmon-og.png")
SWIFT
